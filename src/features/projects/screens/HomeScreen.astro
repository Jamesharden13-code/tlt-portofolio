---
import Heading from '@/components/Heading.astro';
import SkillCard from '@/components/SkillCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, Dumbbell } from 'lucide-react';
import {useState} from 'react'; 
import {allProjects} from '../projectDetails';
import { ui } from '@/i18n/ui';
import heroImage from '@/assets/IMG-CV.jpg';
import { Image } from 'astro:assets';
import FeaturedProjectPreview from '../components/FeaturedProjectPreview.astro';
import type { TranslatedProject, TranslatedSkill } from '../type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroGreeting: string;
  heroSubtitlePart1: string;
  heroSubtitlePart2: string;
  heroIntroduction: string;
  heroViewWorkButton: string;
  heroContactButton: string;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string; // Added for specific project CTA
};

const {
  lang,
  projects,
  skills,
  heroGreeting,
  heroSubtitlePart1,
  heroSubtitlePart2,
  heroIntroduction,
  heroViewWorkButton,
  heroContactButton,
  imageNotAvailable,
  featuredProjectsTitle,
  featuredProjectsDescription,
  mySkillsTitle,
  mySkillsDescription,
  projectPreviewCtaText,
} = Astro.props;

---

<section class="py-12 md:py-16">
  <div class="grid md:grid-cols-2 gap-12 items-center justify-between">
    {/* Hero Text Column */}
    <div class="text-center md:text-left">
      <h1
        class="hero-title text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4"
      >
        {heroGreeting}
      </h1>
      <p class="hero-subtitle text-2xl md:text-3xl font-medium text-muted-foreground mb-2">
        <span>{heroSubtitlePart1}</span>
        <span class="text-primary"> | </span>
        <span>{heroSubtitlePart2}</span>
      </p>
      <p class="hero-intro text-lg text-muted-foreground mb-8">
        {heroIntroduction}
      </p>
      <div
        class="hero-button flex flex-col sm:flex-row gap-4 justify-center md:justify-start"
      >
        <a
          href="/projects"
          class={buttonVariants({ variant: 'default', size: 'lg' })}
        >
          <Dumbbell className="mr-2 size-4" />
          {heroViewWorkButton}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/contact')}
          class={buttonVariants({ variant: 'outline', size: 'lg' })}
        >
          <Calendar className="mr-2 size-4" />
          {heroContactButton}
        </a>
      </div>
    </div>

    {/* Hero Image (Placeholder for now) */}
    <div class="md:text-center flex justify-center">
      <div
        class="hero-image h-64 w-64 md:w-80 md:h-80 rounded-full shadow-xl overflow-hidden border-4 border-muted">
        <Image
          src={heroImage}
          alt={'User profile image'}
          width={400}
          height={400}
          densities={[1, 1.5, 2]}
          quality="max"
          class="h-full w-full object-cover"
          style="object-position: center 20%;"
        />
      </div>
    </div>
  </div>
</section>

{/* Featured Projects Section */}
<section id="projects" class="py-12 md:py-16 bg-muted/20 dark:bg-muted/10">
  <div class="projects-heading">
    <Heading
      title={featuredProjectsTitle}
      description={featuredProjectsDescription}
      className="flex flex-col items-center"
    />
  </div>

  {/* Project One*/}
  <div class="hero-image grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      projects.slice(0, 3).map((project: TranslatedProject) => {
        return (
          <div class="project-card">
            <FeaturedProjectPreview
                lang={lang}
                slug={project.slug}
                title={project.title}
                imageUrl={project.imageUrl}
                imageAltText={project.imageAltText}
                ctaText={projectPreviewCtaText}
            />
          </div>
        );
      })
    }
  </div>
</section>

{/* Skills Section */}
<section id="skills" class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="skills-heading">
       <Heading
          title={mySkillsTitle}
          description={mySkillsDescription}
          className="flex flex-col items-center"
        />
    </div>  
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        skills.map((skill) => (
          <div class="skill-card">
            <SkillCard
              title={skill.title}
              description={skill.description}
              iconName={skill.iconName}
              technologies={skill.technologies}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Fonction qui contient toutes vos animations
  function initAnimations() {
    // 1. Nettoyer les anciens ScrollTriggers pour éviter les doublons/bugs mémoire
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

    // 2. Animation Hero
    const heroTl = gsap.timeline({ defaults: { duration: 1.2, ease: 'power2.out' } });

    heroTl
      .from('.hero-title', { y: 30, opacity: 0, delay: 0.4 })
      .from('.hero-subtitle', { y: 20, opacity: 0 }, '-=0.3')
      .from('.hero-intro', { y: 20, opacity: 0 }, '-=0.3')
      .from('.hero-button', { y: 20, opacity: 0 }, '-=0.3')
      .from('.hero-image', { scale: 0.8, opacity: 0, duration: 1, ease: 'back.out(1.7)' }, '-=0.6');


    if (document.querySelector('.projects-heading')) {
      gsap.from('.projects-heading', {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: 'power3.out',
      });
    }

    // 3. Animation Projets
    if (document.querySelector('#projects')) {
      gsap.from('.project-card', {
        scrollTrigger: {
          trigger: '#projects',
          start: 'top 85%',
        },
        y: 50,
        opacity: 0,
        duration: 0.6,
        stagger: 0.2,
        ease: 'power3.out',
      });
    }

     if (document.querySelector('.skills-heading')) {
      gsap.from('.skills-heading', {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: 'power3.out',
      });
    }


    // 4. Animation Skills
    if (document.querySelector('#skills')) {
      gsap.from('.skill-card', {
        scrollTrigger: {
          trigger: '#skills',
          start: 'top 80%',
        },
        y: 40,
        opacity: 0,
        duration: 0.6,
        stagger: 0.15,
        ease: 'power3.out',
      });
    }

    // 5. Recalculer les positions de ScrollTrigger après le rendu du DOM
    ScrollTrigger.refresh();
  }

  // S'exécute au premier chargement ET à chaque navigation Astro
  document.addEventListener('astro:page-load', initAnimations);
</script>